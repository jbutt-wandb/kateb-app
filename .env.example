# Optional: pre-fill these so the app starts configured.
# If unset, the app will prompt on first launch via an in-app modal,
# and write the values directly into your local .env (gitignored).

# Required: authenticates Forge Inference (OCR) and, if tracing is enabled, Forge Weave.
WANDB_API_KEY=

# Required ONLY when WEAVE_TRACING_ENABLED=true. The Forge Weave traces and the
# captured dataset land in this entity/project. Leave blank to run OCR without
# any Forge Weave tracing (the gear-icon toggle controls this at runtime too).
ENTITY=
PROJECT=

# Optional: enable Forge Weave tracing. When false (default) no traces or dataset
# captures are sent, regardless of whether ENTITY/PROJECT are set. The
# credentials modal exposes this as a single toggle.
WEAVE_TRACING_ENABLED=false

# Optional: vision model used for OCR. One of:
#   moonshotai/Kimi-K2.6  (default)
#   zai-org/GLM-5.3-Flash
#   google/gemma-4-31B-it
#   Qwen/Qwen3.8-27B
#   MiniMaxAI/MiniMax-M3
MODEL=

# Optional: override the Forge Weave Dataset name used by on-download capture.
# Only meaningful when WEAVE_TRACING_ENABLED=true.
KATEB_DATASET_NAME=
